<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="StaffText">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/access_text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="StaffSecondary" parent="StaffText">
        <item name="android:textColor">@color/access_text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="StaffHeading" parent="StaffSecondary">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="StaffButton" parent="Widget.AppCompat.Button">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:background">@drawable/staff_card</item>
        <item name="android:textColor">@color/access_text_primary</item>
        <item name="backgroundTint">@null</item>
    </style>
    <style name="StaffReceptionTile" parent="StaffButton">
        <item name="android:minHeight">110dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>

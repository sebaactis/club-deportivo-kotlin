<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="access_text_body" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/access_text_secondary</item>
    </style>
    <style name="access_text_welcome" parent="access_text_body">
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textColor">@color/access_text_primary</item>
    </style>
    <style name="access_text_title" parent="access_text_welcome">
        <item name="android:textSize">30sp</item>
    </style>
    <style name="access_text_card_title" parent="access_text_body">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/access_text_primary</item>
    </style>
    <style name="access_text_label" parent="access_text_body">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="access_text_caption" parent="access_text_body">
        <item name="android:textSize">12sp</item>
    </style>
    <style name="access_text_badge" parent="access_text_body">
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/access_on_accent</item>
    </style>
    <style name="access_text_error" parent="access_text_caption">
        <item name="android:textColor">@color/access_error</item>
    </style>
    <style name="access_text_success" parent="access_text_caption">
        <item name="android:textColor">@color/access_success</item>
    </style>

    <style name="access_input" parent="Widget.AppCompat.EditText">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/access_text_primary</item>
        <item name="android:textColorHint">@color/access_text_secondary</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:background">@drawable/access_input_member</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
    </style>
    <style name="access_input_staff" parent="access_input">
        <item name="android:background">@drawable/access_input_staff</item>
    </style>

    <style name="access_button" parent="Widget.AppCompat.Button">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/access_on_accent</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:background">@drawable/access_button_member</item>
    </style>
    <style name="access_button_staff" parent="access_button">
        <item name="android:background">@drawable/access_button_staff</item>
    </style>
    <style name="access_button_secondary" parent="access_button">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/access_text_primary</item>
        <item name="android:background">@drawable/access_button_secondary</item>
    </style>
    <style name="access_button_disabled" parent="access_button">
        <item name="android:textColor">@color/access_text_secondary</item>
        <item name="android:background">@drawable/access_button_disabled</item>
    </style>
    <style name="access_language" parent="access_button_secondary">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:background">@drawable/access_language</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#071326"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header: Logo, Idioma y Tema -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Logo -->
        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_yellow"
            android:gravity="center"
            android:text="A"
            android:textColor="#071326"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CLUB DEPORTIVO"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALGORITMO"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Selector Idioma (ES / EN) -->
        <LinearLayout
            android:id="@+id/layoutLang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_lang_selector"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="ES"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="EN"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Botón Tema -->
        <ImageView
            android:id="@+id/btnTheme"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_lang_selector"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_compass"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Título de Bienvenida -->
    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="Bienvenido/a"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold" />

    <!-- Subtítulo -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Elegí con qué perfil querés ingresar al club."
        android:textColor="#94A3B8"
        android:textSize="16sp" />

    <!-- Opción 1: Soy socio -->
    <LinearLayout
        android:id="@+id/btnSocio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp">

        <TextView
            android:id="@+id/iconSocio"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_circle_yellow"
            android:gravity="center"
            android:text="S"
            android:textColor="#071326"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Soy socio"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Reservá clases y mira tus horarios"
                android:textColor="#94A3B8"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/arrowSocio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#94A3B8"
            android:textSize="24sp" />
    </LinearLayout>

    <!-- Opción 2: Soy profesor -->
    <LinearLayout
        android:id="@+id/btnProfesor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp">

        <TextView
            android:id="@+id/iconProfesor"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_circle_blue"
            android:gravity="center"
            android:text="P"
            android:textColor="#071326"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Soy profesor"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Gestioná tu agenda y asistencias"
                android:textColor="#94A3B8"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/arrowProfesor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#94A3B8"
            android:textSize="24sp" />
    </LinearLayout>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/socioCredentialRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/access_navy"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/socio_home_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Credencial del socio"
            android:textSize="26sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/access_text_card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SOLO DEMOSTRACIÓN"
                android:textColor="@color/access_member"
                android:textSize="18sp" />

            <TextView
                style="@style/access_text_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Estos datos son de ejemplo. La identidad y el estado de cuota no están verificados. Esta credencial no es válida para acceder al club."
                android:textColor="@color/access_text_primary"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/access_text_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/socio_home_credential_name" />

            <TextView
                android:id="@+id/tvCredencialNombre"
                style="@style/socio_home_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tvCredencialDni"
                style="@style/access_text_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <TextView
                style="@style/access_text_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/socio_home_credential_number" />

            <TextView
                android:id="@+id/tvCredencialNumero"
                style="@style/access_text_card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="22sp" />

            <TextView
                style="@style/access_text_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/socio_home_credential_quota" />

            <TextView
                android:id="@+id/tvCredencialCuota"
                style="@style/access_text_card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/access_member"
                android:textSize="20sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnVolverCredencial"
            style="@style/access_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="48dp"
            android:padding="12dp"
            android:text="Volver" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/socioHomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/access_navy"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/socioHomeScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="32dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/access_text_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/socio_home_greeting" />

                    <TextView
                        android:id="@+id/tvUserName"
                        style="@style/socio_home_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAvatar"
                    style="@style/access_text_card_title"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/socio_home_avatar"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/socio_home_avatar"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/socio_home_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvCuota"
                    style="@style/access_text_card_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/access_success"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvSocioDetalle"
                    style="@style/access_text_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnVerCredencial"
                    style="@style/access_button"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/socio_home_credential"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                style="@style/socio_home_heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/socio_home_quick_access" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnReservarClase"
                    style="@style/socio_home_card"
                    android:layout_marginEnd="6dp">

                    <TextView
                        style="@style/socio_home_icon"
                        android:text="+" />

                    <TextView
                        style="@style/socio_home_quick_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/socio_home_book" />

                    <TextView
                        style="@style/socio_home_quick_caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/socio_home_book_help" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnMisClases"
                    style="@style/socio_home_card"
                    android:layout_marginStart="6dp">

                    <TextView
                        style="@style/socio_home_icon_blue"
                        android:text="≡" />

                    <TextView
                        style="@style/socio_home_quick_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/socio_home_my_classes" />

                    <TextView
                        android:id="@+id/tvMisClasesCount"
                        style="@style/socio_home_quick_caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnMiRutina"
                    style="@style/socio_home_card"
                    android:layout_marginEnd="6dp">

                    <TextView
                        style="@style/socio_home_icon_blue"
                        android:text="R" />

                    <TextView
                        style="@style/socio_home_quick_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/socio_home_routine" />

                    <TextView
                        style="@style/socio_home_quick_caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/socio_home_routine_help" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnNutricion"
                    style="@style/socio_home_card"
                    android:layout_marginStart="6dp">

                    <TextView
                        style="@style/socio_home_icon"
                        android:text="N" />

                    <TextView
                        style="@style/socio_home_quick_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/socio_home_nutrition" />

                    <TextView
                        style="@style/socio_home_quick_caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/socio_home_nutrition_help" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/socio_home_heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/socio_home_saved_class" />

            <LinearLayout
                android:id="@+id/btnProximaClase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="92dp"
                android:background="@drawable/socio_home_reservation"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvReservaNombre"
                    style="@style/access_text_card_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvReservaHorario"
                    style="@style/access_text_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/tvReservaDetalle"
                    style="@style/access_text_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/access_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnInicio"
            style="@style/socio_home_tab"
            android:background="@drawable/socio_home_active_tab"
            android:textColor="@color/access_member"
            android:text="@string/socio_home_home" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnClases"
            style="@style/socio_home_tab"
            android:text="@string/socio_home_classes" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCredencial"
            style="@style/socio_home_tab"
            android:text="@string/socio_home_card" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPerfil"
            style="@style/socio_home_tab"
            android:text="@string/socio_home_profile" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/accessRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/accessScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintWidth_max="520dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnBack"
                    style="@style/access_language"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="start|center_vertical"
                    android:text="@string/access_back" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEs"
                    style="@style/access_language"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="@string/access_es" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEn"
                    style="@style/access_language"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="@string/access_en" />
            </LinearLayout>
            <TextView
                android:id="@+id/tvRoleBadge"
                style="@style/access_text_badge"
                android:layout_width="wrap_content"
                android:layout_height="27dp"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/access_badge_member" />
            <TextView
                android:id="@+id/tvTitle"
                style="@style/access_text_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />
            <TextView
                android:id="@+id/tvSubtitle"
                style="@style/access_text_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
            <TextView
                android:id="@+id/lblDni"
                style="@style/access_text_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:labelFor="@id/etDni"
                android:text="@string/access_dni" />
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etDni"
                style="@style/access_input"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:inputType="textNoSuggestions"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:hint="@string/access_dni_hint" />
            <TextView
                android:id="@+id/lblPassword"
                style="@style/access_text_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/etPassword"
                android:text="@string/access_password" />
            <LinearLayout
                android:id="@+id/layoutPassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:addStatesFromChildren="true"
                android:background="@drawable/access_input_member">
                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etPassword"
                    style="@style/access_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:imeOptions="actionDone"
                    android:hint="@string/access_password_hint"
                    android:saveEnabled="false" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/tvTogglePassword"
                    style="@style/access_language"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@null" />
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnForgotPassword"
                style="@style/access_language"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="end|center_vertical"
                android:background="@null"
                android:text="@string/access_forgot" />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="6dp">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSubmit"
                    style="@style/access_button"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/access_submit" />
                <ProgressBar
                    android:id="@+id/accessLoading"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="24dp"
                    android:indeterminateTint="@color/access_on_accent"
                    android:contentDescription="@string/access_loading"
                    android:visibility="gone" />
            </FrameLayout>
            <TextView
                android:id="@+id/tvDivider"
                style="@style/access_text_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:text="@string/access_or" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnQr"
                style="@style/access_button_secondary"
                android:layout_width="match_parent"
                android:layout_height="56dp" />
            <TextView
                android:id="@+id/accessBanner"
                style="@style/access_text_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />
            <Space
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_weight="1" />
            <LinearLayout
                android:id="@+id/accessRegistration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">
                <TextView
                    android:id="@+id/tvNoAccount"
                    style="@style/access_text_caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/access_no_account" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnRegister"
                    style="@style/access_language"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@null"
                    android:text="@string/access_register" />
            </LinearLayout>
            <TextView
                android:id="@+id/tvTerms"
                style="@style/access_text_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/access_terms" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

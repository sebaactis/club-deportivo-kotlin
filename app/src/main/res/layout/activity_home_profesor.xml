<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/staffRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/access_navy"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/staffScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/staffBack"
                style="@style/StaffSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/staff_back" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/StaffHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/access_badge_staff"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/staff_badge"
                    android:textColor="@color/access_on_accent" />

                <TextView
                    style="@style/StaffSecondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:gravity="end"
                    android:text="@string/staff_identity" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvProfesorName"
                style="@style/StaffText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/inter_bold"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/staffDate"
                style="@style/StaffSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/staff_card"
                android:orientation="horizontal"
                android:padding="3dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSelectorClasesProfesor"
                    style="@style/StaffButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/access_button_staff"
                    android:text="@string/staff_classes"
                    android:textColor="@color/access_on_accent"
                    app:backgroundTint="@null" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnReceptionProfesor"
                    style="@style/StaffButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:text="@string/staff_reception"
                    android:textColor="@color/access_text_secondary"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/staffClassesPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/StaffHeading"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/staff_agenda" />

                    <TextView
                        android:id="@+id/staffAgendaLink"
                        style="@style/StaffSecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/staff_agenda_link"
                        android:textColor="@color/access_staff" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/staffClassList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    style="@style/StaffHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/staff_shortcuts" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:id="@+id/staffRoutines"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:minHeight="100dp"
                        android:background="@drawable/staff_card"
                        android:foreground="?attr/selectableItemBackground"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/staff_routines_accessibility">

                        <TextView
                            style="@style/StaffText"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/access_circle_staff"
                            android:gravity="center"
                            android:fontFamily="@font/inter_medium"
                            android:importantForAccessibility="no"
                            android:text="R"
                            android:textColor="@color/access_on_accent" />

                        <TextView
                            style="@style/StaffText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/inter_semibold"
                            android:text="@string/staff_routines" />

                        <TextView
                            android:id="@+id/staffRoutineCount"
                            style="@style/StaffSecondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/staffCharge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:minHeight="100dp"
                        android:background="@drawable/staff_card"
                        android:foreground="?attr/selectableItemBackground"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/staff_charge_accessibility">

                        <TextView
                            style="@style/StaffText"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/access_circle_staff"
                            android:gravity="center"
                            android:fontFamily="@font/inter_medium"
                            android:importantForAccessibility="no"
                            android:text="$"
                            android:textColor="@color/access_on_accent" />

                        <TextView
                            style="@style/StaffText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/inter_semibold"
                            android:text="@string/staff_charge" />

                        <TextView
                            style="@style/StaffSecondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/staff_charge_detail" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/staffReceptionPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/staffDueBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="82dp"
                    android:background="@drawable/staff_due_banner"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/staffDueCount"
                        style="@style/StaffText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:accessibilityLiveRegion="polite" />

                    <TextView
                        style="@style/StaffSecondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/staff_due_instruction" />

                    <TextView
                        style="@style/StaffSecondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="@color/access_member"
                        android:text="@string/staff_due_list" />
                </LinearLayout>

                <TextView
                    style="@style/StaffHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/staff_reception_operations" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/staffReceptionCharge"
                        style="@style/StaffReceptionTile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:drawableTop="@drawable/staff_money"
                        android:text="@string/staff_quota_tile"
                        android:contentDescription="@string/staff_choose_quota" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/staffNewMember"
                        style="@style/StaffReceptionTile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:drawableTop="@drawable/staff_person"
                        android:text="@string/staff_new_member_tile" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/staffDailyPass"
                        style="@style/StaffReceptionTile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:drawableTop="@drawable/staff_money"
                        android:text="@string/staff_daily_pass_tile"
                        android:contentDescription="@string/staff_choose_pass" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/staffIssueCard"
                        style="@style/StaffReceptionTile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:drawableTop="@drawable/staff_card_icon"
                        android:text="@string/staff_issue_card_tile"
                        android:contentDescription="@string/staff_choose_card" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/staffAttendance"
        style="@style/StaffButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/access_button_staff"
        android:textColor="@color/access_on_accent"
        app:backgroundTint="@null" />
</LinearLayout>

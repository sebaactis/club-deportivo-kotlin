<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:drawable="@drawable/access_input_disabled" />
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/access_surface" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="@color/access_staff" />
        </shape>
    </item>
    <item android:drawable="@drawable/access_input_default" />
</selector>

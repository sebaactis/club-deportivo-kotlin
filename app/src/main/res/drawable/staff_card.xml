<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/access_surface" />
            <stroke android:width="2dp" android:color="@color/access_staff" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/access_surface" />
            <stroke android:width="1dp" android:color="@color/access_border" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>

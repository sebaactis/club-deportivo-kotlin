<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/access_disabled" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/access_staff" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="@color/access_on_accent" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/access_staff" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="@color/access_text_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/access_staff" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>

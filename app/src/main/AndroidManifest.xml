<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <!-- Pantalla de Selección de Perfil / Bienvenida -->
        <activity
            android:name="com.example.clubdeportivo.ui.inicio.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla de Login -->
        <activity
            android:name="com.example.clubdeportivo.ui.acceso.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pantalla Principal del Socio -->
        <activity
            android:name="com.example.clubdeportivo.ui.socio.HomeSocioActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.example.clubdeportivo.ui.socio.CredencialActivity"
            android:exported="false" />

        <!-- Pantalla de Clases Reservadas -->
        <activity
            android:name="com.example.clubdeportivo.ui.socio.MisClasesActivity"
            android:exported="false" />

        <activity
            android:name="com.example.clubdeportivo.ui.socio.MiRutinaActivity"
            android:exported="false" />

        <activity
            android:name="com.example.clubdeportivo.ui.nutricion.NutricionActivity"
            android:exported="false" />

        <activity
            android:name="com.example.clubdeportivo.ui.reservas.ReservationActivity"
            android:exported="false" />

        <activity
            android:name="com.example.clubdeportivo.ui.reservas.ReservationConfirmationActivity"
            android:exported="false" />

        <activity
            android:name="com.example.clubdeportivo.ui.profesor.ClasesProfesorActivity"
            android:exported="false" />

        <activity
            android:name="com.example.clubdeportivo.ui.profesor.AsistenciaProfesorActivity"
            android:exported="false" />

        <activity
            android:name="com.example.clubdeportivo.ui.recepcion.ReceptionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.example.clubdeportivo.ui.recepcion.CobroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.example.clubdeportivo.ui.recepcion.HistorialPagosActivity"
            android:exported="false" />

        <activity
            android:name="com.example.clubdeportivo.ui.recepcion.PersonaFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pantalla Principal del Profesor / Staff -->
        <activity
            android:name="com.example.clubdeportivo.ui.profesor.HomeProfesorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>